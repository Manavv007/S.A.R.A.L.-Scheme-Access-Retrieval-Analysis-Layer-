# Base URL of the FastAPI backend (server-side only; never exposed to the browser).
# Local dev:
BACKEND_URL=http://localhost:8000/api/v1
# Production example:
# BACKEND_URL=https://saral-api.onrender.com/api/v1

# Must match backend SARAL_API_KEY when auth is enabled. BFF proxies send this
# as X-API-Key; never expose it to the browser.
# SARAL_API_KEY=your-shared-secret
